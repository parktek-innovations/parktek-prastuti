# PRODUCTION REQUIRED: server-only URL approved for Netlify proxy traffic.
# Leave blank only for local UI/build tests; submissions then fail safely with HTTP 503.
CONTACT_INQUIRY_API_URL=

# LOCAL EXAMPLE below. Production must use the exact public origin allowed by the upstream.
PUBLIC_SITE_ORIGIN=http://localhost:8888

# OPTIONAL: override only when hosting the adapter at another same-origin path.
NEXT_PUBLIC_CONTACT_FORM_ENDPOINT=/api/contact-inquiry
