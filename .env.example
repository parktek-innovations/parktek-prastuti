# Server-only URL for a contact-inquiry endpoint approved for Netlify proxy traffic.
CONTACT_INQUIRY_API_URL=

# Origin forwarded by the Netlify form adapter. Must be allowed by the upstream.
PUBLIC_SITE_ORIGIN=http://localhost:8888

# Optional: override only when hosting the server adapter at another same-origin path.
NEXT_PUBLIC_CONTACT_FORM_ENDPOINT=/api/contact-inquiry
